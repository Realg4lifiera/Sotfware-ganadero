# Base de datos PostgreSQL (local con docker-compose, o Supabase en producción).
# En Supabase (Connect › Connection string › URI), sin `sslmode`:
#   DATABASE_URL          = «Transaction pooler» (puerto 6543), la usa la app.
#   DATABASE_URL_UNPOOLED = «Session pooler» (puerto 5432), la usan las migraciones.
# Producción va en .env.produccion (mismas variables) y en Vercel; no la subas a git.
DATABASE_URL="postgresql://ganadero:ganadero@localhost:5432/ganadero?schema=public"
# DATABASE_URL_UNPOOLED=""
# Opcional: CA de Supabase (Settings › Database › SSL) en PEM para verificar el certificado.
# DATABASE_CA=""

# Auth.js: genera uno con `npx auth secret` o `openssl rand -base64 32`.
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# En local con `next start` o detrás de proxy:
AUTH_TRUST_HOST=true

# Almacenamiento de archivos: "local" (disco, solo desarrollo) o "vercel-blob".
ALMACENAMIENTO="local"
# Solo si ALMACENAMIENTO="vercel-blob" (Vercel lo crea al conectar un Blob store).
BLOB_READ_WRITE_TOKEN=""
