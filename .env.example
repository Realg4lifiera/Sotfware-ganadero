# Base de datos PostgreSQL (local con docker-compose, o Neon en producción).
# En Neon usa la cadena "pooled" para DATABASE_URL.
DATABASE_URL="postgresql://ganadero:ganadero@localhost:5432/ganadero?schema=public"
# Solo en Neon: conexión directa (sin pool) para las migraciones. La integración de
# Vercel la crea sola con este nombre. En local no hace falta.
# DATABASE_URL_UNPOOLED=""

# Auth.js: genera uno con `npx auth secret` o `openssl rand -base64 32`.
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# En local con `next start` o detrás de proxy:
AUTH_TRUST_HOST=true

# Almacenamiento de archivos: "local" (disco, solo desarrollo) o "vercel-blob".
ALMACENAMIENTO="local"
# Solo si ALMACENAMIENTO="vercel-blob" (Vercel lo crea al conectar un Blob store).
BLOB_READ_WRITE_TOKEN=""
